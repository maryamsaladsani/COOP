# SQLite file path (Prisma datasource). On Railway this points at the persistent volume.
DATABASE_URL="file:./dev.db"

# Secret used to sign/verify JWT session tokens.
JWT_SECRET=

# Resend API key for transactional email (REQ-17/18/20/32).
RESEND_API_KEY=

# Deployed Vercel frontend origin. No trailing slash. Used for CORS AND as the base URL for
# the branded email template's logo image (src/lib/emailTemplate.js requests
# ${FRONTEND_URL}/assets/coopLogo1.png) — DEPLOYMENT CHECKLIST: this must be set to the real
# production Vercel domain in Railway's environment config, not localhost, or the logo will
# render as broken in every email sent from production.
FRONTEND_URL=http://localhost:3000

# Railway assigns this dynamically in production; used as a local fallback.
PORT=3001

# Directory where uploaded application documents (REQ-01) are stored. On Railway, point
# this at the same persistent volume DATABASE_URL uses so files survive redeploys.
# Optional locally — defaults to a gitignored ./uploads folder.
UPLOADS_DIR=
